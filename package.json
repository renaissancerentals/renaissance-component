{
  "name": "@renaissancerentals/renaissance-component",
  "version": "13.0.11",
  "description": "Renaissance rentals UI component library",
  "author": "asikpradhan",
  "license": "MIT",
  "main": "./lib/index.cjs.js",
  "module": "./lib/index.es.js",
  "types": "./lib/index.d.ts",
  "style": "./lib/index.css",
  "exports": {
    ".": {
      "import": "./lib/index.es.js",
      "require": "./lib/index.cjs.js",
      "types": "./lib/index.d.ts"
    },
    "./index.css": {
      "default": "./lib/index.css"
    },
    "./assets/default-avatar.png": "./lib/assets/default-avatar.png"
  },
  "files": [
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/renaissancerentals/renaissance-component.git"
  },
  "scripts": {
    "start": "npm run storybook",
    "clean": "rimraf lib",
    "prebuild": "npm run clean",
    "clean:tsx": "rimraf lib/*.tsx lib/**/*.tsx lib/**/**/*.tsx lib/**/**/**/*.tsx",
    "clean:stories": "rimraf  lib/*.stories.* lib/**/*.stories.* lib/**/**/*.stories.* lib/**/**/**/*.stories.*",
    "clean:tests": "rimraf lib/*.test.* lib/**/*.test.* lib/setupTests.* lib/__snapshots__/",
    "clean:public": "rimraf lib/CNAME lib/favicon/ lib/favicon.svg",
    "clean:docs": "rimraf docs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:js": "vite build",
    "build": "npm run build:js && npm run build:types && mv lib/renaissance-component.css lib/index.css && npm run postbuild:js && npm run postbuild:clean",
    "postbuild:js": "rsync -avz --exclude='*.ts' --exclude='index.css' src/ lib/",
    "postbuild:clean": "npm run clean:stories && npm run clean:public && npm run clean:tsx && npm run clean:tests",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "deploy": "npm run build-storybook",
    "postdeploy": "cp public/CNAME docs/CNAME && touch docs/.nojekyll",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build -o docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-onboarding": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.15.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^5.0.10",
    "storybook": "^8.6.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^5.0.1",
    "web-vitals": "^2.1.4"
  },
  "dependencies": {
    "@contentmunch/contentmunch-ui": "^1.1.110",
    "axios": "^1.7.7",
    "ga-gtag": "^1.1.7",
    "html-entities": "^2.6.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "react-cookie": "^7.2.1",
    "react-loading-skeleton": "^3.3.1"
  },
  "bugs": {
    "url": "https://github.com/renaissancerentals/renaissance-component/issues"
  },
  "homepage": "https://renaissancerentals.github.io/renaissance-component",
  "directories": {
    "lib": "lib"
  },
  "keywords": [
    "html5",
    "reactjs",
    "ui",
    "component",
    "driven",
    "renaissancerentals",
    "contentmunch-ui"
  ]
}
